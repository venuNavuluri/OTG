<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Vessel_Mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
$Setup.VRConfiguration__c.Vessel_Validation_Rules__c = false,
$User.FirstName != &apos;Dataloader&apos;, 
ISPICKVAL(Installation_Type__c,&quot;Vessel&quot;), 
ISBLANK(Vessel_Name__c))</errorConditionFormula>
    <errorDisplayField>Vessel_Name__c</errorDisplayField>
    <errorMessage>Vessel Name is mandatory.</errorMessage>
</ValidationRule>
